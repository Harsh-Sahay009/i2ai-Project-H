      "title": "Code Dirty",
      "type": "boolean"
    },
    "code_sha": {
      "title": "Code Sha",
      "type": "string"
    },
    "config_sha256": {
      "title": "Config Sha256",
      "type": "string"
    },
    "dataset_sha256": {
      "title": "Dataset Sha256",
      "type": "string"
    },
    "fewshot_sha256": {
      "title": "Fewshot Sha256",
      "type": "string"
    },
    "grammar_version": {
      "title": "Grammar Version",
      "type": "string"
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
