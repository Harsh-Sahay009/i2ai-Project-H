@startuml
title <size:24>Deployment View: Freight Invoice Itemizer - Prototype</size>\n<size:24>Everything runs on team-controlled hardware; only the optional external API leaves it.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Prototype.Teamcontrolledserver, "Team-controlled server", $type="Ubuntu 24.04", $descr="CMU-managed VM or an equivalent team-controlled server. Reachable over HTTPS with username and password login.", $tags="", $link="") {
  Deployment_Node(Prototype.Teamcontrolledserver.Reverseproxy, "Reverse proxy", $type="Caddy", $descr="TLS termination", $tags="", $link="") {
    Deployment_Node(Prototype.Teamcontrolledserver.Reverseproxy.TLSendpoint, "TLS endpoint", $type="Caddy", $descr="Terminates HTTPS and forwards to the UI", $tags="", $link="")
  }

  Deployment_Node(Prototype.Teamcontrolledserver.UIserver, "UI server", $type="FastAPI, Uvicorn", $descr="Single process; launches pipeline jobs in the virtual environment", $tags="", $link="") {
    Container(Prototype.Teamcontrolledserver.UIserver.WebUI_1, "Web UI", $techn="Python, FastAPI, Jinja2, server-rendered HTML", $descr="Browser interface for uploading exports, launching and monitoring runs, exploring results with evidence highlighted in the note, reviewing errors, reviewing and adjudicating rows, blind labelling and reading KPIs. Holds no business logic: it calls the Run Console, Human Review System and stores.", $tags="", $link="")
  }

  Deployment_Node(Prototype.Teamcontrolledserver.Pythonvirtualenvironment, "Python virtual environment", $type="Python 3.12", $descr="Pinned by uv.lock", $tags="", $link="") {
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, "Run Console", $techn="Python 3.12, Typer CLI", $descr="Command-line entry point and the only pipeline orchestrator: 'itemizer run <export.xlsx>'. Resolves configuration, opens a run manifest, runs the stages, and exposes evaluate / review / promote sub-commands. The Web UI launches runs through it.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, "Data Transformation & Check", $techn="Python, pandas, openpyxl", $descr="Reads the TMS Excel export, validates it against the input contract, normalizes fields, fingerprints and de-duplicates notes, and writes an immutable input snapshot.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, "Model Router", $techn="Python", $descr="Decides which model handles each note, enforces the confidentiality gate, applies fallback, caches responses by content hash and meters tokens and cost. The provider interface is the exit path.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, "Itemization Classifier", $techn="Python, pydantic", $descr="Turns one note into charge items with category, amount and exact evidence span using a bounded tool-calling LLM agent; checks evidence, reconciles to the disputed amount, scores confidence and assigns the row outcome. Never invents or edits an amount.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.OutputFormatter_1, "Output Formatter", $techn="Python, openpyxl", $descr="Writes the Excel deliverable: items sheet (one line per charge with evidence), row summary sheet (outcome, totals, discrepancy) and a run info sheet carrying the manifest.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, "Human Review System", $techn="Python, openpyxl", $descr="Review service behind the Web UI: builds the review queue within reviewer capacity, validates and records approvals, edits and adjudications, runs blind labelling for the test set, and closes cases. An Excel review workbook remains as an offline fallback.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, "KPI Calculator", $techn="Python, pandas, scikit-learn, SciPy", $descr="Computes every success and error metric from immutable, versioned inputs only, per population (TRAIN, VALIDATION, TEST, FRESH, PROD), with sample sizes, weights and confidence intervals, and evaluates the Level 1/2/3 gates.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, "Training & Calibration Pipeline", $techn="Python, scikit-learn", $descr="Turns closed cases into candidate changes (prompt, few-shot set, lexicon, thresholds, calibration map), replays them on VALIDATION, and submits them to the promotion gate. Has no read access to locked test labels.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPIDashboard_1, "KPI Dashboard", $techn="Python, Jinja2, Vega-Lite", $descr="Static, self-contained HTML report generated from KPI snapshots (level gates, error breakdown, cost, calibration curve, loop health, run comparison). Shares panel definitions with the Web UI KPI View; used for D5 and offline reading.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, "Agent Tool Library & MCP Server", $techn="Python, MCP Python SDK", $descr="Custom deterministic tools with LLM-oriented docstrings. Pipeline tools are called in-process by the Itemization Agent; analyst tools are served read-only over MCP to Claude Code (team) and to the client's future agent, guided by the skill folder.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, "Guardrail Layer", $techn="Python", $descr="Policy checks around the agent: input guard, tool-call guard, output guard, action guard and privacy guard. Always 'full' in dev and prod; the 'none' and single-guard-off profiles exist only in the experiment environment on synthetic data, for the with/without evaluation.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.SyntheticDataGenerator_1, "Synthetic Data Generator", $techn="Python, Faker, local LLM (optional)", $descr="Generates synthetic dispute exports with gold items by construction, for the public repo, demos, poster, unit tests and adversarial guardrail tests; checks fidelity, privacy and validity before a synthetic set is published.", $tags="", $link="")
    Container(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GroundTruthBootstrap_1, "Ground Truth Bootstrap", $techn="Python, Typer, pandas, openpyxl", $descr="Creates D1 and D2 from the dataset: profiles the notes, builds the TRAIN / VALIDATION / TEST split, drafts the charge category list for client approval, and prepares blind labelling packs, agreement reports and sealing. People write every TEST and VALIDATION label.", $tags="", $link="")
  }

  Deployment_Node(Prototype.Teamcontrolledserver.Ollamaservice, "Ollama service", $type="Ollama", $descr="", $tags="", $link="") {
    Container(Prototype.Teamcontrolledserver.Ollamaservice.LocalModelRuntime_1, "Local Model Runtime", $techn="Ollama", $descr="Self-hosted open-weights model: the tested fallback and exit path, and the route for any data not cleared for external AI.", $tags="", $link="")
  }

  Deployment_Node(Prototype.Teamcontrolledserver.Projectdatavolume, "Project data volume", $type="Filesystem", $descr="Ignored by Git", $tags="", $link="") {
    ContainerDb(Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Version & Artifact Registry", $techn="Filesystem CAS + DuckDB, Git tags", $descr="Content-addressed store and lineage index for every versioned artifact: input snapshots, taxonomy, evaluation sets, prompts, lexicon, calibration maps, model identities, run manifests, outputs, KPI snapshots.", $tags="", $link="")
    ContainerDb(Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Ground Truth Store", $techn="Parquet + DuckDB, access-controlled folder", $descr="Approved charge taxonomy (D1), sealed locked test set (D2), TRAIN, VALIDATION and FRESH sets, the split manifest and labelling records. Test labels are readable only by the KPI Calculator.", $tags="", $link="")
    ContainerDb(Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Telemetry & Episode Store", $techn="DuckDB", $descr="Action telemetry (what happened), decision telemetry (why) and outcome telemetry (what followed), linked by case_id and tagged with the run's version.", $tags="", $link="")
  }

  Deployment_Node(Prototype.Teamcontrolledserver.PrivateGitrepository, "Private Git repository", $type="GitHub private", $descr="Code, configuration, prompts, lexicon, metric definitions", $tags="", $link="") {
    Container(Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Configuration Registry", $techn="YAML in Git, JSON Schema, pydantic", $descr="The configurable layer. Typed parameters with limits, owner, change log and validity horizon; layered resolution core -> environment -> carrier override; every resolved config is hashed into the run manifest.", $tags="", $link="")
  }

}

Deployment_Node(Prototype.LLMprovidercloud, "LLM provider cloud", $type="Vendor cloud", $descr="Anonymized open dataset; any other data needs written approval", $tags="", $link="") {
  System(Prototype.LLMprovidercloud.ExternalLLMAPIProvider_1, "External LLM API Provider", $descr="Hosted large language model inference. Default route for the anonymized open dataset (ADR 0013); any other data needs the client owner's written approval.", $tags="", $link="")
}

Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, "Launches 'itemizer run' as a background job; polls status", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, "Pre-checks uploaded export against the input contract", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, "Starts ingest of the export", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, "Starts itemization for the snapshot", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, "Hands over deduplicated notes", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, "Requests structured itemization per note", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, "Model turn (tool call or final)", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.OutputFormatter_1, "Starts writing the deliverable", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.OutputFormatter_1, "Hands over items and row outcomes", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, "Reads queue; submits decisions, labels and adjudications", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, "Exports / imports review workbooks", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, "Starts scoring for the run", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, "Starts calibration, replay and promotion", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, "Replays notes through current and candidate builds", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, "Requests VALIDATION scoring", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, "Returns VALIDATION scores to the promotion gate", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPIDashboard_1, "Publishes KPI snapshots for rendering", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, "Reads tool schemas and docstrings", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, "Delegates", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, "Calls pipeline tools chosen by the agent", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, "Pre-checks model-bound payloads", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, "Accepted submission", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, "Passes every agent turn, tool call and submission through guards", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, "Runs each profile in experiment env", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, "Allowed call", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, "Submitted items", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Pythonvirtualenvironment.SyntheticDataGenerator_1, "Uses SYNTH and ADV sets for the guardrail ablation", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, Prototype.Teamcontrolledserver.Ollamaservice.LocalModelRuntime_1, "Prompt, structured output request", $techn="HTTP/JSON", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.SyntheticDataGenerator_1, Prototype.Teamcontrolledserver.Ollamaservice.LocalModelRuntime_1, "Optional template paraphrase", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Stores uploads; reads runs, predictions, outputs and KPI snapshots", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Opens and closes the run manifest", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Writes raw + normalized input snapshots", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Writes predictions", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.OutputFormatter_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Registers the output workbook hash", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Reads predictions and run manifests", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Reads manifests and predictions; writes KPI snapshots", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Registers candidate and published versions", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPIDashboard_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Reads KPI snapshots, manifests and the split manifest", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Reads runs and KPI snapshots for analyst tools", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.SyntheticDataGenerator_1, Prototype.Teamcontrolledserver.Projectdatavolume.VersionArtifactRegistry_1, "Publishes synthetic sets after quality checks", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Reads TEST and VALIDATION fingerprints to keep them out of tuning data", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Reads the approved taxonomy version", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Writes labels for TRAIN, VALIDATION and FRESH sets", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Reads sealed gold labels (only reader of TEST labels)", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Reads TRAIN and VALIDATION labels (never TEST)", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Reads taxonomy", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.SyntheticDataGenerator_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Reads taxonomy; registers synthetic gold sets (SYNTH, ADV)", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GroundTruthBootstrap_1, Prototype.Teamcontrolledserver.Projectdatavolume.GroundTruthStore_1, "Seals TEST; registers labels, split manifest and approved taxonomy", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Reads decision telemetry to explain outcomes; writes UI audit events", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.DataTransformationCheck_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Writes data-quality action telemetry", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Writes action telemetry: route, latency, tokens, cost", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Writes decision telemetry per item and row", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Writes outcome telemetry and closed cases", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Reads cost, review and loop telemetry", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Reads closed cases (TRAIN/PROD only)", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Reads decision telemetry for explain_row", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, Prototype.Teamcontrolledserver.Projectdatavolume.TelemetryEpisodeStore_1, "Writes guard decisions (block, quarantine, resubmit)", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.UIserver.WebUI_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads role map, upload limits and review settings", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.RunConsole_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Resolves and freezes the effective config", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads routing policy, approval flag, model ids, budgets", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ItemizationClassifier_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads thresholds, tolerances, prompt and lexicon versions", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.HumanReviewSystem_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads audit sample rate and weekly capacity", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.KPICalculator_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads metric set, weights, targets, price table versions", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.TrainingCalibrationPipeline_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Publishes approved parameter changes", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.AgentToolLibraryMCPServer_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads lexicon and tolerances", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GuardrailLayer_1, Prototype.Teamcontrolledserver.PrivateGitrepository.ConfigurationRegistry_1, "Reads guardrails.profile and budgets", $techn="", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.ModelRouter_1, Prototype.LLMprovidercloud.ExternalLLMAPIProvider_1, "Prompt, structured output request", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Prototype.Teamcontrolledserver.Pythonvirtualenvironment.GroundTruthBootstrap_1, Prototype.LLMprovidercloud.ExternalLLMAPIProvider_1, "TRAIN notes, structured output request", $techn="HTTPS/JSON", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml