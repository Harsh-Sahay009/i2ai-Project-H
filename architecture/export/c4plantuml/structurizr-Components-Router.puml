@startuml
title <size:24>Component View: Freight Invoice Itemizer - Model Router</size>\n<size:24>Level 3 — control over models we do not own: routing, confidentiality gate, fallback, cache, cost.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(ExternalLLMAPIProvider, "External LLM API Provider", $descr="Hosted large language model inference. Default route for the anonymized open dataset (ADR 0013); any other data needs the client owner's written approval.", $tags="", $link="")

System_Boundary("FreightInvoiceItemizer_boundary", "Freight Invoice Itemizer", $tags="") {
  Container_Boundary("FreightInvoiceItemizer.ModelRouter_boundary", "Model Router", $tags="") {
    Component(FreightInvoiceItemizer.ModelRouter.ModelRegistry, "Model Registry", $techn="YAML, pydantic", $descr="Lists models in config/models.yaml with provider, model id, settings and prices. A model on a known API takes one entry; a new API family takes one adapter and one line. Names the variable holding a key and never holds the key.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, "Routing Policy Engine", $techn="Python", $descr="Applies the configured route: rules-only, local model, or external API, with per-carrier and per-size overrides.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.ConfidentialityGate, "Confidentiality Gate", $techn="Python", $descr="Blocks any external call unless the dataset class is open_anonymized with a recorded source, or 'external_ai_approved' is true with an approval reference. Fails closed.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.ProviderInterface, "Provider Interface", $techn="Python Protocol", $descr="Stable contract: complete(prompt, schema, params) -> structured response + usage. Every adapter must pass the same contract tests.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.ExternalAPIAdapter, "External API Adapter", $techn="HTTPS SDK", $descr="Adapter for the hosted LLM API: structured output, retries, timeouts, rate limits.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.LocalModelAdapter, "Local Model Adapter", $techn="HTTP", $descr="Adapter for the self-hosted model runtime.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.ResponseCache, "Response Cache", $techn="SQLite", $descr="Keyed by hash(prompt, model id, decoding params). Makes reruns reproducible and cheap; never used across model versions.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.FallbackController, "Fallback Controller", $techn="Python", $descr="On provider error, timeout or schema failure, retries then falls back down the configured order; rows that exhaust fallbacks go to Review, never to a guessed answer.", $tags="", $link="")
    Component(FreightInvoiceItemizer.ModelRouter.CostMeter, "Cost Meter", $techn="Python", $descr="Records tokens in/out, latency and price-table version per call.", $tags="", $link="")
  }

  Container(FreightInvoiceItemizer.ConfigurationRegistry, "Configuration Registry", $techn="YAML in Git, JSON Schema, pydantic", $descr="The configurable layer. Typed parameters with limits, owner, change log and validity horizon; layered resolution core -> environment -> carrier override; every resolved config is hashed into the run manifest.", $tags="", $link="")
  ContainerDb(FreightInvoiceItemizer.TelemetryEpisodeStore, "Telemetry & Episode Store", $techn="DuckDB", $descr="Action telemetry (what happened), decision telemetry (why) and outcome telemetry (what followed), linked by case_id and tagged with the run's version.", $tags="", $link="")
  Container(FreightInvoiceItemizer.LocalModelRuntime, "Local Model Runtime", $techn="Ollama", $descr="Self-hosted open-weights model: the tested fallback and exit path, and the route for any data not cleared for external AI.", $tags="", $link="")
  Container(FreightInvoiceItemizer.ItemizationClassifier, "Itemization Classifier", $techn="Python, pydantic", $descr="Turns one note into charge items with category, amount and exact evidence span using a bounded tool-calling LLM agent; checks evidence, reconciles to the disputed amount, scores confidence and assigns the row outcome. Never invents or edits an amount.", $tags="", $link="")
  Container(FreightInvoiceItemizer.GuardrailLayer, "Guardrail Layer", $techn="Python", $descr="Policy checks around the agent: input guard, tool-call guard, output guard, action guard and privacy guard. Always 'full' in dev and prod; the 'none' and single-guard-off profiles exist only in the experiment environment on synthetic data, for the with/without evaluation.", $tags="", $link="")
}

Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.ConfigurationRegistry, "Reads thresholds, tolerances, prompt and lexicon versions", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.TelemetryEpisodeStore, "Writes decision telemetry per item and row", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.GuardrailLayer, "Passes every agent turn, tool call and submission through guards", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.GuardrailLayer, FreightInvoiceItemizer.ConfigurationRegistry, "Reads guardrails.profile and budgets", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.GuardrailLayer, FreightInvoiceItemizer.TelemetryEpisodeStore, "Writes guard decisions (block, quarantine, resubmit)", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.GuardrailLayer, FreightInvoiceItemizer.ItemizationClassifier, "Accepted submission", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.GuardrailLayer, FreightInvoiceItemizer.ModelRouter.ConfidentialityGate, "Pre-checks model-bound payloads", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, "Itemization request", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, FreightInvoiceItemizer.ConfigurationRegistry, "Reads route, model ids, budget", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, FreightInvoiceItemizer.ModelRouter.ModelRegistry, "Reads the chosen model's entry", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ModelRegistry, FreightInvoiceItemizer.ModelRouter.ProviderInterface, "Selects the adapter for the entry", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, FreightInvoiceItemizer.ModelRouter.ResponseCache, "Looks up cached response", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, FreightInvoiceItemizer.ModelRouter.ConfidentialityGate, "Candidate external call", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ConfidentialityGate, FreightInvoiceItemizer.ModelRouter.ProviderInterface, "Allowed call", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.RoutingPolicyEngine, FreightInvoiceItemizer.ModelRouter.ProviderInterface, "Local call", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ProviderInterface, FreightInvoiceItemizer.ModelRouter.ExternalAPIAdapter, "Dispatches", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ProviderInterface, FreightInvoiceItemizer.ModelRouter.LocalModelAdapter, "Dispatches", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ExternalAPIAdapter, ExternalLLMAPIProvider, "HTTPS/JSON", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.LocalModelAdapter, FreightInvoiceItemizer.LocalModelRuntime, "HTTP/JSON", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ProviderInterface, FreightInvoiceItemizer.ModelRouter.FallbackController, "Errors, timeouts, schema failures", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.FallbackController, FreightInvoiceItemizer.ModelRouter.ProviderInterface, "Next provider in order", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ProviderInterface, FreightInvoiceItemizer.ModelRouter.CostMeter, "Usage", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.CostMeter, FreightInvoiceItemizer.TelemetryEpisodeStore, "Action telemetry", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter.ProviderInterface, FreightInvoiceItemizer.ModelRouter.ResponseCache, "Stores response", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml