@startuml
title <size:24>Component View: Freight Invoice Itemizer - Training & Calibration Pipeline</size>\n<size:24>Level 3 — closed loop: case to candidate to replay to promotion gate to published change.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(ItemizerOperator, "Itemizer Operator", $descr="Project team member who uploads exports and launches runs (UI or CLI), reviews errors, owns configuration and publishes versioned changes.", $tags="", $link="")

System_Boundary("FreightInvoiceItemizer_boundary", "Freight Invoice Itemizer", $tags="") {
  Container_Boundary("FreightInvoiceItemizer.TrainingCalibrationPipeline_boundary", "Training & Calibration Pipeline", $tags="") {
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.ClosedCaseMiner, "Closed Case Miner", $techn="Python", $descr="Reads closed DEV/PROD cases, groups them by adjudication bucket; only 'AI wrong' and 'context changed' cases may change behaviour.", $tags="", $link="")
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.CandidateChangeGenerator, "Candidate Change Generator", $techn="Python", $descr="Proposes lexicon entries, few-shot swaps, prompt edits and taxonomy change requests as a versioned change set.", $tags="", $link="")
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.ThresholdCalibrator, "Threshold Calibrator", $techn="scikit-learn", $descr="Fits the confidence calibration map and review thresholds on DEV to hit a target precision for Verified rows.", $tags="", $link="")
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.ReplayRunner, "Replay Runner", $techn="Python", $descr="Replays the replay packs against the current and the candidate build and diffs outputs row by row.", $tags="", $link="")
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.PromotionGate, "Promotion Gate", $techn="Python", $descr="Requests one aggregate TEST evaluation per candidate within the peek budget, requires no regression on any error type, then asks the operator to publish.", $tags="", $link="")
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.ChangePublisher, "Change Publisher", $techn="Python", $descr="Publishes a change with owner, evidence, version, rollback pointer and validity horizon to the configuration and version registries.", $tags="", $link="")
    Component(FreightInvoiceItemizer.TrainingCalibrationPipeline.RecertificationScheduler, "Recertification Scheduler", $techn="Python", $descr="Flags published changes whose validity horizon has passed or whose model/provider version changed silently; re-runs FRESH evaluation.", $tags="", $link="")
  }

  Container(FreightInvoiceItemizer.ConfigurationRegistry, "Configuration Registry", $techn="YAML in Git, JSON Schema, pydantic", $descr="The configurable layer. Typed parameters with limits, owner, change log and validity horizon; layered resolution core -> environment -> carrier override; every resolved config is hashed into the run manifest.", $tags="", $link="")
  ContainerDb(FreightInvoiceItemizer.VersionArtifactRegistry, "Version & Artifact Registry", $techn="Filesystem CAS + DuckDB, Git tags", $descr="Content-addressed store and lineage index for every versioned artifact: input snapshots, taxonomy, evaluation sets, prompts, lexicon, calibration maps, model identities, run manifests, outputs, KPI snapshots.", $tags="", $link="")
  ContainerDb(FreightInvoiceItemizer.GroundTruthStore, "Ground Truth Store", $techn="Parquet + DuckDB, access-controlled folder", $descr="Approved charge taxonomy (D1), sealed locked test set (D2), DEV set, FRESH set and labelling records. Test labels are readable only by the KPI Calculator.", $tags="", $link="")
  ContainerDb(FreightInvoiceItemizer.TelemetryEpisodeStore, "Telemetry & Episode Store", $techn="DuckDB", $descr="Action telemetry (what happened), decision telemetry (why) and outcome telemetry (what followed), linked by case_id and tagged with the run's version.", $tags="", $link="")
  Container(FreightInvoiceItemizer.RunConsole, "Run Console", $techn="Python 3.12, Typer CLI", $descr="Command-line entry point and the only pipeline orchestrator: 'itemizer run <export.xlsx>'. Resolves configuration, opens a run manifest, runs the stages, and exposes evaluate / review / promote sub-commands. The Web UI launches runs through it.", $tags="", $link="")
  Container(FreightInvoiceItemizer.ModelRouter, "Model Router", $techn="Python", $descr="Decides which model handles each note, enforces the confidentiality gate, applies fallback, caches responses by content hash and meters tokens and cost. The provider interface is the exit path.", $tags="", $link="")
  Container(FreightInvoiceItemizer.KPICalculator, "KPI Calculator", $techn="Python, pandas, scikit-learn, SciPy", $descr="Computes every success and error metric from immutable, versioned inputs only, per population (TEST, DEV, FRESH, PROD), with sample sizes, weights and confidence intervals, and evaluates the Level 1/2/3 gates.", $tags="", $link="")
}

Rel(ItemizerOperator, FreightInvoiceItemizer.RunConsole, "Runs 'itemizer run', 'evaluate', 'promote'", $techn="CLI", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.ConfigurationRegistry, "Resolves and freezes the effective config", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.VersionArtifactRegistry, "Opens and closes the run manifest", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.KPICalculator, "Starts scoring for the run", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter, FreightInvoiceItemizer.ConfigurationRegistry, "Reads routing policy, approval flag, model ids, budgets", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter, FreightInvoiceItemizer.TelemetryEpisodeStore, "Writes action telemetry: route, latency, tokens, cost", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.KPICalculator, FreightInvoiceItemizer.VersionArtifactRegistry, "Reads manifests and predictions; writes KPI snapshots", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.KPICalculator, FreightInvoiceItemizer.GroundTruthStore, "Reads sealed gold labels (only reader of TEST labels)", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.KPICalculator, FreightInvoiceItemizer.TelemetryEpisodeStore, "Reads cost, review and loop telemetry", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.KPICalculator, FreightInvoiceItemizer.ConfigurationRegistry, "Reads metric set, weights, targets, price table versions", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.KPICalculator, FreightInvoiceItemizer.TrainingCalibrationPipeline.PromotionGate, "Aggregate TEST verdict", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.TrainingCalibrationPipeline.ClosedCaseMiner, "calibrate / promote", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ClosedCaseMiner, FreightInvoiceItemizer.TelemetryEpisodeStore, "Reads closed cases", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ClosedCaseMiner, FreightInvoiceItemizer.TrainingCalibrationPipeline.CandidateChangeGenerator, "AI-wrong and context-changed cases", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.CandidateChangeGenerator, FreightInvoiceItemizer.TrainingCalibrationPipeline.ThresholdCalibrator, "Candidate build", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ThresholdCalibrator, FreightInvoiceItemizer.GroundTruthStore, "Reads DEV labels only", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ThresholdCalibrator, FreightInvoiceItemizer.TrainingCalibrationPipeline.ReplayRunner, "Calibrated candidate", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ReplayRunner, FreightInvoiceItemizer.ModelRouter, "Replays notes", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ReplayRunner, FreightInvoiceItemizer.TrainingCalibrationPipeline.PromotionGate, "Replay diff + DEV scores", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.PromotionGate, FreightInvoiceItemizer.KPICalculator, "One aggregate TEST evaluation", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.PromotionGate, FreightInvoiceItemizer.TrainingCalibrationPipeline.ChangePublisher, "Approved candidate", $techn="", $tags="", $link="")
Rel(ItemizerOperator, FreightInvoiceItemizer.TrainingCalibrationPipeline.PromotionGate, "Approves publication", $techn="CLI", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ChangePublisher, FreightInvoiceItemizer.ConfigurationRegistry, "Publishes parameter change", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.ChangePublisher, FreightInvoiceItemizer.VersionArtifactRegistry, "Tags published version + rollback pointer", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.RecertificationScheduler, FreightInvoiceItemizer.ConfigurationRegistry, "Reads validity horizons", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.TrainingCalibrationPipeline.RecertificationScheduler, FreightInvoiceItemizer.KPICalculator, "Requests FRESH re-evaluation", $techn="", $tags="", $link="")
Rel(ItemizerOperator, FreightInvoiceItemizer.ConfigurationRegistry, "Proposes parameter changes via pull request", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml