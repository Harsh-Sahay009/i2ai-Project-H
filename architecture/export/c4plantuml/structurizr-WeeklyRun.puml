@startuml
title <size:24>Dynamic View: Freight Invoice Itemizer</size>\n<size:24>Weekly run: export uploaded in the UI, itemized results reviewed, KPIs scored.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("FreightInvoiceItemizer_boundary", "Freight Invoice Itemizer", $tags="") {
  Container(FreightInvoiceItemizer.WebUI, "Web UI", $techn="Python, FastAPI, Jinja2, server-rendered HTML", $descr="Browser interface for uploading exports, launching and monitoring runs, exploring results with evidence highlighted in the note, reviewing errors, reviewing and adjudicating rows, blind labelling and reading KPIs. Holds no business logic: it calls the Run Console, Human Review System and stores.", $tags="", $link="")
  Container(FreightInvoiceItemizer.ConfigurationRegistry, "Configuration Registry", $techn="YAML in Git, JSON Schema, pydantic", $descr="The configurable layer. Typed parameters with limits, owner, change log and validity horizon; layered resolution core -> environment -> carrier override; every resolved config is hashed into the run manifest.", $tags="", $link="")
  ContainerDb(FreightInvoiceItemizer.VersionArtifactRegistry, "Version & Artifact Registry", $techn="Filesystem CAS + DuckDB, Git tags", $descr="Content-addressed store and lineage index for every versioned artifact: input snapshots, taxonomy, evaluation sets, prompts, lexicon, calibration maps, model identities, run manifests, outputs, KPI snapshots.", $tags="", $link="")
  ContainerDb(FreightInvoiceItemizer.TelemetryEpisodeStore, "Telemetry & Episode Store", $techn="DuckDB", $descr="Action telemetry (what happened), decision telemetry (why) and outcome telemetry (what followed), linked by case_id and tagged with the run's version.", $tags="", $link="")
  Container(FreightInvoiceItemizer.RunConsole, "Run Console", $techn="Python 3.12, Typer CLI", $descr="Command-line entry point and the only pipeline orchestrator: 'itemizer run <export.xlsx>'. Resolves configuration, opens a run manifest, runs the stages, and exposes evaluate / review / promote sub-commands. The Web UI launches runs through it.", $tags="", $link="")
  Container(FreightInvoiceItemizer.DataTransformationCheck, "Data Transformation & Check", $techn="Python, pandas, openpyxl", $descr="Reads the TMS Excel export, validates it against the input contract, normalizes fields, fingerprints and de-duplicates notes, and writes an immutable input snapshot.", $tags="", $link="")
  Container(FreightInvoiceItemizer.ModelRouter, "Model Router", $techn="Python", $descr="Decides which model handles each note, enforces the confidentiality gate, applies fallback, caches responses by content hash and meters tokens and cost. The provider interface is the exit path.", $tags="", $link="")
  Container(FreightInvoiceItemizer.ItemizationClassifier, "Itemization Classifier", $techn="Python, pydantic", $descr="Turns one note into charge items with category, amount and exact evidence span using a bounded tool-calling LLM agent; checks evidence, reconciles to the disputed amount, scores confidence and assigns the row outcome. Never invents or edits an amount.", $tags="", $link="")
  Container(FreightInvoiceItemizer.OutputFormatter, "Output Formatter", $techn="Python, openpyxl", $descr="Writes the Excel deliverable: items sheet (one line per charge with evidence), row summary sheet (outcome, totals, discrepancy) and a run info sheet carrying the manifest.", $tags="", $link="")
  Container(FreightInvoiceItemizer.KPICalculator, "KPI Calculator", $techn="Python, pandas, scikit-learn, SciPy", $descr="Computes every success and error metric from immutable, versioned inputs only, per population (TRAIN, VALIDATION, TEST, FRESH, PROD), with sample sizes, weights and confidence intervals, and evaluates the Level 1/2/3 gates.", $tags="", $link="")
}

Person(PPGAccountant, "PPG Accountant", $descr="Uploads the weekly export, explores itemized results, approves or edits rows in the Review UI, downloads the itemized workbook, and alone decides what is paid.", $tags="", $link="")
System(ExternalLLMAPIProvider, "External LLM API Provider", $descr="Hosted large language model inference. Default route for the anonymized open dataset (ADR 0013); any other data needs the client owner's written approval.", $tags="", $link="")

Rel(PPGAccountant, FreightInvoiceItemizer.WebUI, "1: Upload export.xlsx", $techn="HTTPS", $tags="", $link="")
Rel(FreightInvoiceItemizer.WebUI, FreightInvoiceItemizer.DataTransformationCheck, "2: Pre-check input contract", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.WebUI, FreightInvoiceItemizer.VersionArtifactRegistry, "3: Register raw export", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.WebUI, FreightInvoiceItemizer.RunConsole, "4: Launch itemizer run (background job)", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.ConfigurationRegistry, "5: Resolve + hash effective config", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.VersionArtifactRegistry, "6: Open run manifest", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.DataTransformationCheck, "7: Ingest", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.DataTransformationCheck, FreightInvoiceItemizer.VersionArtifactRegistry, "8: Write input snapshot", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.DataTransformationCheck, FreightInvoiceItemizer.ItemizationClassifier, "9: Distinct notes", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.ModelRouter, "10: Itemize note", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ModelRouter, ExternalLLMAPIProvider, "11: Structured request (default route)", $techn="HTTPS/JSON", $tags="", $link="")
Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.TelemetryEpisodeStore, "12: Decision telemetry", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.ItemizationClassifier, FreightInvoiceItemizer.OutputFormatter, "13: Items + outcomes", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.OutputFormatter, FreightInvoiceItemizer.VersionArtifactRegistry, "14: Register itemized workbook", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.RunConsole, FreightInvoiceItemizer.KPICalculator, "15: Score run", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.KPICalculator, FreightInvoiceItemizer.VersionArtifactRegistry, "16: Write KPI snapshot", $techn="", $tags="", $link="")
Rel(FreightInvoiceItemizer.WebUI, FreightInvoiceItemizer.VersionArtifactRegistry, "17: Show results, evidence and KPIs; offer workbook download", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml