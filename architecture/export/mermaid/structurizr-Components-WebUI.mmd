    1["<div style='font-weight: bold'>PPG Accountant</div><div style='font-size: 70%; margin-top: 0px'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Uploads the weekly export,<br />explores itemized results,<br />approves or edits rows in the<br />Review UI, downloads the<br />itemized workbook, and alone<br />decides what is paid.</div>"]
    style 1 fill:#343ced,stroke:#242aa5,color:#ffffff
    2["<div style='font-weight: bold'>PPG Client Owner</div><div style='font-size: 70%; margin-top: 0px'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Freight Analytics lead at<br />PPG. Approves the charge<br />category list (D1), reviews<br />the 50 double-labelled notes<br />and resolves label<br />disagreements for the locked<br />test set (D2), reviews the<br />prototype (D3) and KPIs in<br />the UI, and authorizes<br />external AI use on anything<br />other than the anonymized<br />open dataset.</div>"]
    style 2 fill:#343ced,stroke:#242aa5,color:#ffffff
    3["<div style='font-weight: bold'>Itemizer Operator</div><div style='font-size: 70%; margin-top: 0px'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Project team member who<br />uploads exports and launches<br />runs (UI or CLI), reviews<br />errors, owns configuration<br />and publishes versioned<br />changes.</div>"]
    style 3 fill:#343ced,stroke:#242aa5,color:#ffffff
    4["<div style='font-weight: bold'>Labeler / Adjudicator</div><div style='font-size: 70%; margin-top: 0px'>[Person]</div><div style='font-size: 80%; margin-top:10px'>Team member or PPG accountant<br />who labels notes blind and<br />adjudicates review cases into<br />the four buckets in the UI.</div>"]
    style 4 fill:#343ced,stroke:#242aa5,color:#ffffff

    subgraph 9 ["Freight Invoice Itemizer"]
      style 9 fill:#ffffff,stroke:#1b1c24,color:#1b1c24

      subgraph 10 ["Web UI"]
        style 10 fill:#ffffff,stroke:#343ced,color:#343ced

        11["<div style='font-weight: bold'>Auth & Role Guard</div><div style='font-size: 70%; margin-top: 0px'>[Component: FastAPI, pydantic]</div><div style='font-size: 80%; margin-top:10px'>Username and password login<br />with hashed passwords, signed<br />session cookie and CSRF<br />tokens; maps the user to a<br />role (operator, accountant,<br />labeler, client owner) from<br />config; enforces page and<br />data permissions on the<br />server; blind labellers never<br />receive predictions.</div>"]
        style 11 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        12["<div style='font-weight: bold'>Upload & Pre-check Page</div><div style='font-size: 70%; margin-top: 0px'>[Component: HTML form, FastAPI]</div><div style='font-size: 80%; margin-top:10px'>Accepts an .xlsx export<br />within the size limit, runs<br />the input contract check as a<br />preview, and registers the<br />raw file in the CAS before<br />any run starts. Synthetic<br />demo uploads are labelled and<br />listed apart.</div>"]
        style 12 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        13["<div style='font-weight: bold'>Run Launcher & Monitor</div><div style='font-size: 70%; margin-top: 0px'>[Component: subprocess, Python]</div><div style='font-size: 80%; margin-top:10px'>Starts 'itemizer run' as a<br />background job for a<br />registered snapshot, shows<br />stage progress, budget stops<br />and failures from telemetry;<br />one run at a time per<br />environment.</div>"]
        style 13 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        14["<div style='font-weight: bold'>Results Explorer</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2, pandas]</div><div style='font-size: 80%; margin-top:10px'>Rows by outcome, carrier and<br />disputed dollars; items with<br />their evidence highlighted<br />inside the raw note; reasons<br />for every Review and<br />Discrepancy; download of the<br />itemized workbook.</div>"]
        style 14 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        15["<div style='font-weight: bold'>Error Review Workbench</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2]</div><div style='font-size: 80%; margin-top:10px'>Row-level error analysis by<br />error type (a–g) on TRAIN and<br />PROD; VALIDATION shows<br />aggregates only, and TEST<br />shows aggregates only until<br />the final freeze releases<br />error examples for D5.</div>"]
        style 15 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        16["<div style='font-weight: bold'>Review Queue Page</div><div style='font-size: 70%; margin-top: 0px'>[Component: HTML forms, plain JavaScript]</div><div style='font-size: 80%; margin-top:10px'>Capacity-bounded queue;<br />approve / edit / reject with<br />corrected items and a reason<br />code; audit-sample rows hide<br />the tool's outcome and<br />confidence.</div>"]
        style 16 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        17["<div style='font-weight: bold'>Adjudication Page</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2]</div><div style='font-size: 80%; margin-top:10px'>Sorts overrides into AI<br />wrong, human wrong, context<br />changed or genuine exception<br />with a reason code;<br />adjudicator must differ from<br />the original reviewer.</div>"]
        style 17 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        18["<div style='font-weight: bold'>Blind Labelling Page</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2]</div><div style='font-size: 80%; margin-top:10px'>Labels notes into gold items<br />without any tool output;<br />shows the second labeller<br />nothing of the first; review<br />and disagreement resolution<br />view for the client reviewer.</div>"]
        style 18 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        19["<div style='font-weight: bold'>Agent Trace Viewer</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2]</div><div style='font-size: 80%; margin-top:10px'>For a selected row, shows the<br />agent's step-by-step trace:<br />each LLM turn, tool call with<br />arguments and result, guard<br />decisions (blocked,<br />quarantined, resubmitted) and<br />the terminal tool. Makes the<br />agentic design visible in the<br />demo.</div>"]
        style 19 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        20["<div style='font-weight: bold'>Tool Reference Page</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2]</div><div style='font-size: 80%; margin-top:10px'>Lists every agent tool with<br />its docstring and schema from<br />the Tool Registry.</div>"]
        style 20 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        21["<div style='font-weight: bold'>KPI View</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2, Vega-Lite]</div><div style='font-size: 80%; margin-top:10px'>Renders KPI snapshots with<br />the same panel definitions as<br />the static dashboard; never<br />computes metrics; offers the<br />HTML report for download.</div>"]
        style 21 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        22["<div style='font-weight: bold'>UI Audit Logger</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python]</div><div style='font-size: 80%; margin-top:10px'>Records who uploaded,<br />launched, decided, labelled<br />or downloaded what, by role<br />and pseudonymous id.</div>"]
        style 22 fill:#f4f4f6,stroke:#aaaaac,color:#272834
      end

      110["<div style='font-weight: bold'>Configuration Registry</div><div style='font-size: 70%; margin-top: 0px'>[Container: YAML in Git, JSON Schema, pydantic]</div><div style='font-size: 80%; margin-top:10px'>The configurable layer. Typed<br />parameters with limits,<br />owner, change log and<br />validity horizon; layered<br />resolution core -><br />environment -> carrier<br />override; every resolved<br />config is hashed into the run<br />manifest.</div>"]
      style 110 fill:#d8f1f6,stroke:#ef601b,color:#272834
      114[("<div style='font-weight: bold'>Version & Artifact Registry</div><div style='font-size: 70%; margin-top: 0px'>[Container: Filesystem CAS + DuckDB, Git tags]</div><div style='font-size: 80%; margin-top:10px'>Content-addressed store and<br />lineage index for every<br />versioned artifact: input<br />snapshots, taxonomy,<br />evaluation sets, prompts,<br />lexicon, calibration maps,<br />model identities, run<br />manifests, outputs, KPI<br />snapshots.</div>")]
      style 114 fill:#e2e3fb,stroke:#ef601b,color:#272834
      122[("<div style='font-weight: bold'>Telemetry & Episode Store</div><div style='font-size: 70%; margin-top: 0px'>[Container: DuckDB]</div><div style='font-size: 80%; margin-top:10px'>Action telemetry (what<br />happened), decision telemetry<br />(why) and outcome telemetry<br />(what followed), linked by<br />case_id and tagged with the<br />run's version.</div>")]
      style 122 fill:#e2e3fb,stroke:#343ced,color:#272834
      23["<div style='font-weight: bold'>Run Console</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python 3.12, Typer CLI]</div><div style='font-size: 80%; margin-top:10px'>Command-line entry point and<br />the only pipeline<br />orchestrator: 'itemizer run<br /><export.xlsx>'. Resolves<br />configuration, opens a run<br />manifest, runs the stages,<br />and exposes evaluate / review<br />/ promote sub-commands. The<br />Web UI launches runs through<br />it.</div>"]
      style 23 fill:#e2e3fb,stroke:#ef601b,color:#272834
      28["<div style='font-weight: bold'>Data Transformation & Check</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, pandas, openpyxl]</div><div style='font-size: 80%; margin-top:10px'>Reads the TMS Excel export,<br />validates it against the<br />input contract, normalizes<br />fields, fingerprints and<br />de-duplicates notes, and<br />writes an immutable input<br />snapshot.</div>"]
      style 28 fill:#e2e3fb,stroke:#343ced,color:#272834
      55["<div style='font-weight: bold'>Human Review System</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, openpyxl]</div><div style='font-size: 80%; margin-top:10px'>Review service behind the Web<br />UI: builds the review queue<br />within reviewer capacity,<br />validates and records<br />approvals, edits and<br />adjudications, runs blind<br />labelling for the test set,<br />and closes cases. An Excel<br />review workbook remains as an<br />offline fallback.</div>"]
      style 55 fill:#e2e3fb,stroke:#343ced,color:#272834
      86["<div style='font-weight: bold'>Agent Tool Library & MCP Server</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, MCP Python SDK]</div><div style='font-size: 80%; margin-top:10px'>Custom deterministic tools<br />with LLM-oriented docstrings.<br />Pipeline tools are called<br />in-process by the Itemization<br />Agent; analyst tools are<br />served read-only over MCP to<br />Claude Code (team) and to the<br />client's future agent, guided<br />by the skill folder.</div>"]
      style 86 fill:#e2e3fb,stroke:#343ced,color:#272834
    end

