      subgraph 439 ["Python virtual environment"]
        style 439 fill:#ffffff,stroke:#444444,color:#444444

        440["<div style='font-weight: bold'>Run Console</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python 3.12, Typer CLI]</div><div style='font-size: 80%; margin-top:10px'>Command-line entry point and<br />the only pipeline<br />orchestrator: 'itemizer run<br /><export.xlsx>'. Resolves<br />configuration, opens a run<br />manifest, runs the stages,<br />and exposes evaluate / review<br />/ promote sub-commands. The<br />Web UI launches runs through<br />it.</div>"]
        style 440 fill:#e2e3fb,stroke:#ef601b,color:#272834
        442["<div style='font-weight: bold'>Data Transformation & Check</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, pandas, openpyxl]</div><div style='font-size: 80%; margin-top:10px'>Reads the TMS Excel export,<br />validates it against the<br />input contract, normalizes<br />fields, fingerprints and<br />de-duplicates notes, masks<br />names, and writes an<br />immutable input snapshot.</div>"]
        style 442 fill:#e2e3fb,stroke:#343ced,color:#272834
        445["<div style='font-weight: bold'>Model Router</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python]</div><div style='font-size: 80%; margin-top:10px'>Decides which model handles<br />each note, enforces the<br />confidentiality gate, applies<br />fallback, caches responses by<br />content hash and meters<br />tokens and cost. The provider<br />interface is the exit path.</div>"]
        style 445 fill:#e2e3fb,stroke:#ef601b,color:#272834
        446["<div style='font-weight: bold'>Itemization Classifier</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, pydantic]</div><div style='font-size: 80%; margin-top:10px'>Turns one note into charge<br />items with category, amount<br />and exact evidence span using<br />a bounded tool-calling LLM<br />agent; checks evidence,<br />reconciles to the disputed<br />amount, scores confidence and<br />assigns the row outcome.<br />Never invents or edits an<br />amount.</div>"]
        style 446 fill:#e2e3fb,stroke:#343ced,color:#272834
        451["<div style='font-weight: bold'>Output Formatter</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, openpyxl]</div><div style='font-size: 80%; margin-top:10px'>Writes the Excel deliverable:<br />items sheet (one line per<br />charge with evidence), row<br />summary sheet (outcome,<br />totals, discrepancy) and a<br />run info sheet carrying the<br />manifest.</div>"]
        style 451 fill:#e2e3fb,stroke:#343ced,color:#272834
        454["<div style='font-weight: bold'>Human Review System</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, openpyxl]</div><div style='font-size: 80%; margin-top:10px'>Review service behind the Web<br />UI: builds the review queue<br />within reviewer capacity,<br />validates and records<br />approvals, edits and<br />adjudications, runs blind<br />labelling for the test set,<br />and closes cases. An Excel<br />review workbook remains as an<br />offline fallback.</div>"]
        style 454 fill:#e2e3fb,stroke:#343ced,color:#272834
        457["<div style='font-weight: bold'>KPI Calculator</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, pandas, scikit-learn, SciPy]</div><div style='font-size: 80%; margin-top:10px'>Computes every success and<br />error metric from immutable,<br />versioned inputs only, per<br />population (TEST, DEV, FRESH,<br />PROD), with sample sizes,<br />weights and confidence<br />intervals, and evaluates the<br />Level 1/2/3 gates.</div>"]
        style 457 fill:#e2e3fb,stroke:#343ced,color:#272834
        459["<div style='font-weight: bold'>Training & Calibration Pipeline</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, scikit-learn]</div><div style='font-size: 80%; margin-top:10px'>Turns closed cases into<br />candidate changes (prompt,<br />few-shot set, lexicon,<br />thresholds, calibration map),<br />replays them on DEV, and<br />submits them to the promotion<br />gate. Has no read access to<br />locked test labels.</div>"]
        style 459 fill:#d8f1f6,stroke:#343ced,color:#272834
        464["<div style='font-weight: bold'>KPI Dashboard</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, Jinja2, Vega-Lite]</div><div style='font-size: 80%; margin-top:10px'>Static, self-contained HTML<br />report generated from KPI<br />snapshots (level gates, error<br />breakdown, cost, calibration<br />curve, loop health, run<br />comparison). Shares panel<br />definitions with the Web UI<br />KPI View; used for D5 and<br />offline reading.</div>"]
        style 464 fill:#e2e3fb,stroke:#343ced,color:#272834
        466["<div style='font-weight: bold'>Agent Tool Library & MCP Server</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, MCP Python SDK]</div><div style='font-size: 80%; margin-top:10px'>Custom deterministic tools<br />with LLM-oriented docstrings.<br />Pipeline tools are called<br />in-process by the Itemization<br />Agent; analyst tools are<br />served read-only over MCP to<br />Claude Code (team) and to the<br />client's future agent, guided<br />by the skill folder.</div>"]
        style 466 fill:#e2e3fb,stroke:#343ced,color:#272834
        469["<div style='font-weight: bold'>Guardrail Layer</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python]</div><div style='font-size: 80%; margin-top:10px'>Policy checks around the<br />agent: input guard, tool-call<br />guard, output guard, action<br />guard and privacy guard.<br />Always 'full' in dev and<br />prod; the 'none' and<br />single-guard-off profiles<br />exist only in the experiment<br />environment on synthetic<br />data, for the with/without<br />evaluation.</div>"]
        style 469 fill:#e2e3fb,stroke:#ef601b,color:#272834
        476["<div style='font-weight: bold'>Synthetic Data Generator</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, Faker, local LLM (optional)]</div><div style='font-size: 80%; margin-top:10px'>Generates synthetic dispute<br />exports with gold items by<br />construction, for the public<br />repo, demos, poster, unit<br />tests and adversarial<br />guardrail tests; checks<br />fidelity, privacy and<br />validity before a synthetic<br />set is published.</div>"]
        style 476 fill:#e2e3fb,stroke:#343ced,color:#272834
      end

