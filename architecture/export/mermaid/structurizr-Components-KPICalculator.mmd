        75["<div style='font-weight: bold'>KPI Snapshot Writer</div><div style='font-size: 70%; margin-top: 0px'>[Component: DuckDB]</div><div style='font-size: 80%; margin-top:10px'>Writes an immutable KPI<br />snapshot keyed by run,<br />evaluation set, metric<br />definitions, weights and<br />price table versions.</div>"]
