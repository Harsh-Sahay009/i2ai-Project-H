        68["<div style='font-weight: bold'>Level Gate Evaluator</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python]</div><div style='font-size: 80%; margin-top:10px'>Compares coverage and<br />accuracy, with intervals,<br />against the configured Level<br />1/2/3 targets and reports<br />pass, fail or inconclusive.</div>"]
