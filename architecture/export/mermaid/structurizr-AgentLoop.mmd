graph LR
  linkStyle default fill:#ffffff

  subgraph diagram ["Dynamic View: Freight Invoice Itemizer - Itemization Classifier"]
    style diagram fill:#ffffff,stroke:#ffffff

    subgraph 9 ["Freight Invoice Itemizer"]
      style 9 fill:#ffffff,stroke:#1b1c24,color:#1b1c24

      subgraph 43 ["Itemization Classifier"]
        style 43 fill:#ffffff,stroke:#343ced,color:#343ced

        45["<div style='font-weight: bold'>Prompt Builder</div><div style='font-size: 70%; margin-top: 0px'>[Component: Jinja2]</div><div style='font-size: 80%; margin-top:10px'>Builds the agent's system<br />prompt and task message from<br />the versioned template,<br />taxonomy definitions,<br />few-shot set (never<br />containing test-set notes)<br />and extractor hints; wraps<br />note text as untrusted data.</div>"]
        style 45 fill:#d8f1f6,stroke:#ef601b,color:#272834
        46["<div style='font-weight: bold'>Itemization Agent Controller</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python]</div><div style='font-size: 80%; margin-top:10px'>Bounded ReAct-style loop: the<br />pretrained LLM (via the<br />router) chooses tool calls;<br />deterministic tools do all<br />arithmetic, lookup and<br />verification; the loop ends<br />only through<br />submit_itemization or<br />escalate_to_review, within<br />step and call budgets.</div>"]
        style 46 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        47["<div style='font-weight: bold'>Structured Response Parser</div><div style='font-size: 70%; margin-top: 0px'>[Component: pydantic]</div><div style='font-size: 80%; margin-top:10px'>Validates the model output<br />against the item schema;<br />malformed output is a<br />failure, not something to<br />repair by guessing.</div>"]
        style 47 fill:#f4f4f6,stroke:#aaaaac,color:#272834
      end

      subgraph 83 ["Agent Tool Library & MCP Server"]
        style 83 fill:#ffffff,stroke:#343ced,color:#343ced

        84["<div style='font-weight: bold'>extract_money_spans</div><div style='font-size: 70%; margin-top: 0px'>[Component: Tool]</div><div style='font-size: 80%; margin-top:10px'>Returns every money token,<br />quantity, rate, tax and<br />already-paid phrase in a note<br />with exact character offsets.</div>"]
        style 84 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        87["<div style='font-weight: bold'>compute_rate_times_quantity</div><div style='font-size: 70%; margin-top: 0px'>[Component: Tool]</div><div style='font-size: 80%; margin-top:10px'>Multiplies two numeric spans<br />from the note in Decimal and<br />returns the product with both<br />spans as derivation evidence.</div>"]
        style 87 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        88["<div style='font-weight: bold'>verify_evidence_span</div><div style='font-size: 70%; margin-top: 0px'>[Component: Tool]</div><div style='font-size: 80%; margin-top:10px'>Checks that a quoted text is<br />verbatim in the raw note at<br />the given offsets and<br />contains the claimed amount<br />or derivation.</div>"]
        style 88 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        89["<div style='font-weight: bold'>reconcile_row</div><div style='font-size: 70%; margin-top: 0px'>[Component: Tool]</div><div style='font-size: 80%; margin-top:10px'>Computes items total,<br />already-paid net and delta<br />against the row's disputed<br />amount with the configured<br />tolerance; never changes<br />amounts.</div>"]
        style 89 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        90["<div style='font-weight: bold'>submit_itemization</div><div style='font-size: 70%; margin-top: 0px'>[Component: Tool]</div><div style='font-size: 80%; margin-top:10px'>Terminal tool. Accepts items<br />only in the ChargeItem schema<br />with verified evidence;<br />anything else is rejected<br />with a reason the agent can<br />act on.</div>"]
        style 90 fill:#f4f4f6,stroke:#aaaaac,color:#272834
      end

      subgraph 94 ["Guardrail Layer"]
        style 94 fill:#ffffff,stroke:#ef601b,color:#ef601b

        95["<div style='font-weight: bold'>Input Guard (untrusted note text)</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python, regex + classifier]</div><div style='font-size: 80%; margin-top:10px'>Delimits note text as data,<br />strips control sequences,<br />detects instruction-like<br />content (prompt injection)<br />and quarantines it as a<br />Review reason.</div>"]
        style 95 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        96["<div style='font-weight: bold'>Tool-Call Guard</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python]</div><div style='font-size: 80%; margin-top:10px'>Allowlist per agent, argument<br />schema validation, step<br />budget, call budget,<br />duplicate-call detection,<br />terminal-tool requirement.</div>"]
        style 96 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        97["<div style='font-weight: bold'>Output Guard</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python]</div><div style='font-size: 80%; margin-top:10px'>Schema validation, evidence<br />verbatim check, no-edit<br />check, category in taxonomy;<br />a failing submission goes<br />back to the agent once, then<br />to Review.</div>"]
        style 97 fill:#f4f4f6,stroke:#aaaaac,color:#272834
      end

      33["<div style='font-weight: bold'>Model Router</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python]</div><div style='font-size: 80%; margin-top:10px'>Decides which model handles<br />each note, enforces the<br />confidentiality gate, applies<br />fallback, caches responses by<br />content hash and meters<br />tokens and cost. The provider<br />interface is the exit path.</div>"]
      style 33 fill:#e2e3fb,stroke:#ef601b,color:#272834
    end

    33["<div style='font-weight: bold'>Model Router</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python]</div><div style='font-size: 80%; margin-top:10px'>Decides which model handles<br />each note, enforces the<br />confidentiality gate, applies<br />fallback, caches responses by<br />content hash and meters<br />tokens and cost. The provider<br />interface is the exit path.</div>"]
    style 33 fill:#e2e3fb,stroke:#ef601b,color:#272834

