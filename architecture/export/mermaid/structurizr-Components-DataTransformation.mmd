        30["<div style='font-weight: bold'>Input Contract Validator</div><div style='font-size: 70%; margin-top: 0px'>[Component: pandera]</div><div style='font-size: 80%; margin-top:10px'>Checks required columns,<br />types and currency; assigns a<br />row id; flags repeated<br />invoices, blank notes and<br />non-positive deltas; emits a<br />data-quality report and<br />blocks on fatal errors.</div>"]
