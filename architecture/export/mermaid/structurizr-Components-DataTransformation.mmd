        28["<div style='font-weight: bold'>Input Contract Validator</div><div style='font-size: 70%; margin-top: 0px'>[Component: pandera]</div><div style='font-size: 80%; margin-top:10px'>Checks required columns,<br />types, currency, disputed<br />amount > 0, duplicate invoice<br />keys; emits a data-quality<br />report and blocks on fatal<br />errors.</div>"]
        style 28 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        29["<div style='font-weight: bold'>Field Normalizer</div><div style='font-size: 70%; margin-top: 0px'>[Component: Python]</div><div style='font-size: 80%; margin-top:10px'>Normalizes whitespace,<br />encodings and numeric formats<br />into derived columns; raw<br />note text is kept<br />byte-for-byte for evidence<br />checks.</div>"]
        style 29 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        30["<div style='font-weight: bold'>Note Fingerprinter</div><div style='font-size: 70%; margin-top: 0px'>[Component: SHA-256]</div><div style='font-size: 80%; margin-top:10px'>Hashes normalized note text<br />so repeated notes are<br />itemized once and fanned back<br />out to every row; also<br />excludes locked-test-set<br />notes from tuning data.</div>"]
        style 30 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        31["<div style='font-weight: bold'>Confidentiality Masker</div><div style='font-size: 70%; margin-top: 0px'>[Component: regex + NER (spaCy)]</div><div style='font-size: 80%; margin-top:10px'>Replaces person names, phone<br />numbers and emails with<br />stable placeholders before<br />any text leaves the team<br />boundary; keeps a reversible<br />map on team storage only.</div>"]
        style 31 fill:#f4f4f6,stroke:#aaaaac,color:#272834
        32["<div style='font-weight: bold'>Snapshot Writer</div><div style='font-size: 70%; margin-top: 0px'>[Component: pyarrow]</div><div style='font-size: 80%; margin-top:10px'>Writes raw and normalized<br />tables as content-addressed<br />Parquet snapshots and<br />registers them in the version<br />registry.</div>"]
        style 32 fill:#f4f4f6,stroke:#aaaaac,color:#272834
      end

      10["<div style='font-weight: bold'>Web UI</div><div style='font-size: 70%; margin-top: 0px'>[Container: Python, Streamlit, OIDC login]</div><div style='font-size: 80%; margin-top:10px'>Browser interface for<br />uploading exports, launching<br />and monitoring runs,<br />exploring results with<br />evidence highlighted in the<br />note, reviewing errors,<br />reviewing and adjudicating<br />rows, blind labelling and<br />reading KPIs. Holds no<br />business logic: it calls the<br />Run Console, Human Review<br />System and stores.</div>"]
      style 10 fill:#e2e3fb,stroke:#343ced,color:#272834
