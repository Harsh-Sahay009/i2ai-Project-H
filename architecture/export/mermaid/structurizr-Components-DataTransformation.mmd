        27["<div style='font-weight: bold'>Export Reader</div><div style='font-size: 70%; margin-top: 0px'>[Component: openpyxl]</div><div style='font-size: 80%; margin-top:10px'>Reads the weekly .xlsx export<br />without altering raw cell<br />values.</div>"]
